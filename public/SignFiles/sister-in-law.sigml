<?xml version="1.0" encoding="utf-8"?>
<sigml>
  <!-- Pehla Hisa: Sister -->
  <hns_sign gloss="sister">
    <hamnosys_nonmanual></hamnosys_nonmanual>
    <hamnosys_manual>
      <hamfist/><hamthumboutmod/><hamextfingeru/><hampalml/><hamnose/><hamtouch/><hammoveo/><hammovedo/>
    </hamnosys_manual>
  </hns_sign>

  <!-- Dusra Hisa: Law -->
  <hns_sign gloss="law">
    <hamnosys_nonmanual></hamnosys_nonmanual>
    <hamnosys_manual>
      <hamsymmlr/>
      <hamfinger23/>
      <hamthumbacrossmod/>
      <hamextfingerl/>
      <hampalml/>
      <hamchest/>
      <hamclose/>
      <hamnomotion/>
      <hammover/>
    </hamnosys_manual>
  </hns_sign>
</sigml>