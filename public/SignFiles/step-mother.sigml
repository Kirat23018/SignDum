  <!-- Dusra Hisa: Mother -->
  <hns_sign gloss="mother">
    <hamnosys_nonmanual>
    </hamnosys_nonmanual>
    <hamnosys_manual>
      <hamfist/>
      <hamthumboutmod/>
      <hamextfingeru/>
      <hampalml/>
      <hamnose/>
      <hamtouch/>
    </hamnosys_manual>
  </hns_sign>
</sigml>