<sigml>
  <!-- Pehla Hisa: Step -->
  <hns_sign gloss="step">
    <hamnosys_nonmanual>
    </hamnosys_nonmanual>
    <hamnosys_manual>
      <hamfinger23spread/>
      <hamextfingeru/>
      <hampalmd/>
      <hamchest/>
      <hammoveo/>
