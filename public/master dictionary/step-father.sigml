<?xml version="1.0" encoding="utf-8"?>
<sigml>
  <!-- Pehla Hisa: Step -->
  <hns_sign gloss="step">
    <hamnosys_nonmanual>
    </hamnosys_nonmanual>
    <hamnosys_manual>
      <hamfinger23spread/>
      <hamextfingeru/>
      <hampalmd/>
      <hamchest/>
      <hammoveo/>
    </hamnosys_manual>
  </hns_sign>

  <!-- Dusra Hisa: Father -->
  <hns_sign gloss="father">
    <hamnosys_nonmanual>
    </hamnosys_nonmanual>
    <hamnosys_manual>
      <hamfist/>
      <hamthumbacrossmod/>
      <hamextfingeru/>
      <hampalml/>
      <hamchin/>
      <hamtouch/>
    </hamnosys_manual>
  </hns_sign>
</sigml>