<?xml version="1.0" encoding="utf-8"?>
<sigml>

  <!-- Pehla Hisa: Father (Tumhara Moustache wala code) -->
  <hns_sign gloss="father">
    <hamnosys_nonmanual>
      <hnm_mouthpicture picture="fA:D@"/>
    </hamnosys_nonmanual>
    <hamnosys_manual>
      <hamsymmlr/>
      <hamfinger23/>
      <hamthumbacrossmod/>
      <hamparbegin/>
      <hamextfingerol/>
      <hampalmd/>
      <hambetween/>
      <hampalmdl/>
      <hamplus/>
      <hamextfingeror/>
      <hampalmd/>
      <hambetween/>
      <hampalmdr/>
      <hamparend/>
      <hamparbegin/>
      <hamfingernail/>
      <hamindexfinger/>
      <hammiddlefinger/>
      <hamplus/>
      <hamfingerpad/>
      <hamindexfinger/>
      <hammiddlefinger/>
      <hamparend/>
      <hamclose/>
      <hamparbegin/>
      <hammoved/>
      <hamplus/>
      <hamnomotion/>
      <hamparend/>
      <hamparbegin/>
      <hamfingernail/>
      <hamindexfinger/>
      <hammiddlefinger/>
      <hamplus/>
      <hamfingerpad/>
      <hamindexfinger/>
      <hammiddlefinger/>
      <hamparend/>
      <hamtouch/>
      <!-- YAHAN SE <hamrepeatfromstart/> HATA DIYA HAI TAAKI PLAYER AAGE BADHE -->
    </hamnosys_manual>
  </hns_sign>

  <!-- Dusra Hisa: Law (Tumhari pasand ka Horizontal & Front View) -->
  <hns_sign gloss="law">
    <hamnosys_nonmanual>
    </hamnosys_nonmanual>
    <hamnosys_manual>
      <hamsymmlr/>
      <hamfinger23/>
      <hamthumbacrossmod/>
      <!-- Dono hath horizontally ek dusre ki taraf point karenge -->
      <hamextfingerl/>
      <!-- Palm left karne se ungliyon ka front (back-side) camera ki taraf dikhega -->
      <hampalml/>
      <hamchest/>
      <!-- Takkar se bachne ke liye <hamclose/> aur ek chota pause -->
      <hamclose/>
      <hamnomotion/>
      <!-- Hath bahar ki taraf alag honge -->
      <hammover/>
    </hamnosys_manual>
  </hns_sign>

</sigml>